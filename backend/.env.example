# codeLinc dental backend — environment variable NAMES only.
# Copy to backend/.env (gitignored) and fill in real values locally.
# NEVER commit real credentials, connection strings, or tokens.

# --- Neon PostgreSQL ---
# Use the Neon connection string. JDBC form, e.g.:
#   jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Amazon Bedrock ---
# Region is fixed to us-east-2 for this project. Override only if you know why.
BEDROCK_REGION=us-east-2
# Nova 2 Lite inference ID confirmed working via the Converse API.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# --- Benefits-education chatbot (separate, dedicated model) ---
# The education chatbot uses its own model ID, which MAY differ from
# BEDROCK_MODEL_ID above. Leave blank to run the chatbot with its deterministic
# plain-language fallback (glossary answers still work, no model call). Region
# and credentials are shared with the Bedrock settings above.
EDUCATION_BEDROCK_ENABLED=true
EDUCATION_BEDROCK_MODEL_ID=

# Bedrock authentication. This is consumed by the AWS SDK default credential
# chain; the app never reads it directly. Export it in your shell:
#   export AWS_BEARER_TOKEN_BEDROCK=...
AWS_BEARER_TOKEN_BEDROCK=

# --- CORS (dev) ---
# Comma-separated list of allowed origins. Defaults to the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
