# Copy to .env (git-ignored) and fill in. Names only here: never commit a real value.

# Mapbox public token (starts with pk.) for the map on the Providers page.
# Optional: without it the page shows the list of dentists and no map.
# It ships in the browser bundle, so use a public token and restrict it to your site's URL
# in your Mapbox account (https://account.mapbox.com/access-tokens/). Maps are billed per load.
VITE_MAPBOX_TOKEN=
